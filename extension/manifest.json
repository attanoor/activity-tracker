{
  "manifest_version": 3,
  "name": "Activity Tracker",
  "version": "0.2.0",
  "description": "Tells the Activity Tracker agent on this PC which site is in the active tab, and what the page is about (headings, menu, club name). Never reads what you type. Works only with the agent.",
  "key": "",
  "permissions": [
    "tabs",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:47823/*"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Activity Tracker",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "extract.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
